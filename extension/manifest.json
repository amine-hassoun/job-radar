{
  "manifest_version": 3,
  "name": "Job Radar Capture",
  "version": "0.4.0",
  "description": "Capture the LinkedIn job postings I'm viewing, for personal fit scoring.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*.lambda-url.eu-west-3.on.aws/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
